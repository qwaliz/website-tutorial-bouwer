<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mijn website</title>
<style>
  :root {
    --ink: #1b1b18;
    --paper: #faf8f4;
    --accent: #3457d5;
    --muted: #6b6a63;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
  }

  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  header h1 {
    font-size: 2.1rem;
    margin: 0 0 0.4rem;
    letter-spacing: -0.01em;
  }

  header p {
    color: var(--muted);
    margin: 0 0 3rem;
    font-size: 1.05rem;
  }

  section { margin-bottom: 2.75rem; }

  section h2 {
    font-size: 1rem;
    text-transform: none;
    margin: 0 0 0.75rem;
    border-bottom: 1px solid #e4e1d8;
    padding-bottom: 0.5rem;
  }

  section p { margin: 0; }

  ul.links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  ul.links li { margin-bottom: 0.6rem; }

  ul.links a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  ul.links a:hover {
    border-bottom-color: var(--accent);
  }

  footer {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 4rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #f1efe9;
      --paper: #161513;
      --muted: #96948b;
      --accent: #7c93ff;
    }
    section h2 { border-bottom-color: #2c2a26; }
  }
</style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>Jouw naam</h1>
      <p>Wat je doet, in een korte zin.</p>
    </header>

    <section>
      <h2>Over mij</h2>
      <p>
        Vertel hier iets over jezelf: wie je bent, waar je aan werkt,
        of waarom je deze site hebt gemaakt.
      </p>
    </section>

    <section>
      <h2>Projecten</h2>
      <ul class="links">
        <li><a href="#">Project een</a> &mdash; korte omschrijving</li>
        <li><a href="#">Project twee</a> &mdash; korte omschrijving</li>
      </ul>
    </section>

    <section>
      <h2>Contact</h2>
      <ul class="links">
        <li><a href="mailto:jij@example.com">jij@example.com</a></li>
        <li><a href="https://github.com/jouwgebruikersnaam">GitHub</a></li>
      </ul>
    </section>

    <footer>
      Gemaakt met GitHub Pages.
    </footer>
  </div>
</body>
</html>
